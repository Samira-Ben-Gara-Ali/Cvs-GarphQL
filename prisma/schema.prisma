generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  USER
  ADMIN
}

model User {
  id    Int     @id @default(autoincrement())
  name  String
  email String?
  role  Role

  cvs Cv[]
}

model Cv {
  id   Int     @id @default(autoincrement())
  name String
  age  Int?
  job  String?

  userId Int
  user   User @relation(fields: [userId], references: [id])

  skills Skill[] @relation("CvSkills")
}

model Skill {
  id          Int    @id @default(autoincrement())
  designation String

  cvs Cv[] @relation("CvSkills")
}
